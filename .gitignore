# === Dependencies ===
# npm is the package manager; package-lock.json is committed (CI runs npm ci).
node_modules/
npm-debug.log*
yarn.lock
yarn-debug.log*
yarn-error.log*
pnpm-lock.yaml

# === Next.js / Vercel ===
.next/
out/
.turbo/
.vercel/
.vercel
.tailwindcache/

# === Generated client bundles (esbuild, scripts/bundle-legacy.ts) ===
# Regenerated by `npm run bundle:js` via predev/prebuild/pretest; never hand-edit.
# The .ts files under public/js and public/color-palette are the source of truth.
public/js/legacy-early.js
public/js/legacy-early.js.map
public/js/legacy-main.js
public/js/legacy-main.js.map
api/_lib/*.js

# === Generated / transient build files ===
# body-html.ts IS tracked (CI enforces sync); only the temp transpile file is ignored.
app/legacy/.body-render.tmp.cjs
dist/
build/
*.tsbuildinfo

# === Environment and secrets ===
# Ignore every dotenv file; only the placeholder template is tracked.
.env*
!.env.example
*.pem

# === Supabase local/dev artifacts (migrations stay tracked) ===
supabase/.branches/
supabase/.temp/
supabase/functions/.env

# === Tests and reports ===
test-results/
playwright-report/
blob-report/
coverage/
.nyc_output/

# === Logs and temp files ===
*.log
*.tmp
*.temp
.cache/

# === IDE and editor files ===
.vscode/
.idea/
.cursor/
.history/
*.code-workspace
*.swp
*.swo
*~

# === Agent / tooling local state ===
# .claude/settings.local.json is machine-local permissions (shared project
# settings would live in .claude/settings.json). .superpowers/ holds internal
# agent planning docs. .zcodeignore is a machine-local tool mirror of this file.
.claude/settings.local.json
.superpowers/
.zcodeignore

# === Linters/formatters ===
.eslintcache
.prettiercache

# === OS files ===
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini
